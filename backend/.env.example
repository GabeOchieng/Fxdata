# ── Core ────────────────────────────────────────────────
ENV=development
DEBUG=true
BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars

# ── Data stores ─────────────────────────────────────────
# Production (Postgres):
# DATABASE_URL=postgresql+asyncpg://kazi:secret@db:5432/kazihub
# Local dev / tests (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./kazihub.db
REDIS_URL=redis://localhost:6379/0

# ── Frontend serving ────────────────────────────────────
SERVE_FRONTEND=true
FRONTEND_DIR=../frontend

# ── M-Pesa (Safaricom Daraja) ───────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=

# ── WhatsApp Business Cloud API ─────────────────────────
WA_TOKEN=
WA_PHONE_ID=

# ── SMS (Africa's Talking) / Email (SendGrid) ──────────
AT_USERNAME=sandbox
AT_API_KEY=
SENDGRID_API_KEY=
